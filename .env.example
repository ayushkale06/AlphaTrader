# Environment Configuration Template for AlphaTrader

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# Market Data Streaming Credentials (Simulated / Public NSE API)
MARKET_DATA_WS_URL=wss://live-market.alphatrader.internal/ws/v1/ticks
NSE_API_KEY=your_sanitized_api_key_here

# PostgreSQL Database Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=alphatrader_db
POSTGRES_USER=alphatrader_user
POSTGRES_PASSWORD=alphatrader_secure_password

# Redis State Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Model API Credentials (LLM Agents)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Risk Engine Thresholds
MAX_DAILY_DRAWDOWN_PCT=2.0
MAX_POSITION_SIZE_PCT=5.0
MAX_SLIPPAGE_PCT=0.25
