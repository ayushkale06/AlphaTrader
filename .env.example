# ==============================================================================
# AlphaTrader Environment Configuration (.env.example)
# Copy to .env for local overrides: cp .env.example .env
# NEVER commit .env or real credentials to version control.
# ==============================================================================

# --- Core Application Metadata ---
# Runtime environment: development | staging | test
APP_ENV=development
# Logical microservice or agent identifier emitted in structured JSON logs
SERVICE_NAME=alphatrader-core

# --- NON-NEGOTIABLE PAPER TRADING SAFETY BOUNDARY (ADR-002) ---
# Must always be PAPER. Setting LIVE or any other value raises a fatal startup error.
TRADING_MODE=PAPER
# Hard safety lock. Must always be false. Setting true raises a fatal startup error.
LIVE_TRADING_ENABLED=false

# --- Market & Portfolio Configuration (NSE NIFTY 50) ---
# Canonical exchange timezone for all market timestamps
MARKET_TIMEZONE=Asia/Kolkata
# Market data ingestion mode: SIMULATED | REPLAY | LIVE
NSE_MARKET_FEED_MODE=SIMULATED
# Starting virtual capital in INR for the paper portfolio ledger (default: 1,00,00,000 INR / 1 Crore)
INITIAL_PAPER_CAPITAL_INR=10000000.0

# --- Deterministic Risk Guardrail Invariants (Non-LLM) ---
# Maximum allowed intraday drawdown percentage from daily high-water mark before floor halt (0 < x <= 5.0)
MAX_DAILY_DRAWDOWN_PCT=2.0
# Maximum single-stock position notional as a percentage of total portfolio equity (0 < x <= 20.0)
MAX_POSITION_SIZE_PCT=5.0
# Maximum concurrent open equity positions across NIFTY 50 constituents (1 <= x <= 50)
MAX_OPEN_POSITIONS=10
# Maximum orders per minute before the deterministic rate-limiter trips
MAX_ORDERS_PER_MINUTE=30

# --- Data & Messaging Infrastructure (Local Docker Defaults) ---
# PostgreSQL 16 system-of-record connection parameters (Portfolio Ledger & Audit Trail)
# Bound to 5433 to avoid port conflicts with host PostgreSQL installations on 5432
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=alphatrader
POSTGRES_PASSWORD=alphatrader_local_dev_only
POSTGRES_DB=alphatrader_ledger

# Redis 7 low-latency state & circuit-breaker cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Redpanda 24.x (Kafka API) event streaming broker bootstrap servers
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
REDPANDA_BROKERS=127.0.0.1:9092
KAFKA_SCHEMA_REGISTRY_URL=http://127.0.0.1:8081


# --- Observability & Structured Logging ---
# Minimum log severity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Emit structured single-line JSON logs with correlation_id propagation
LOG_JSON=true
# OpenTelemetry OTLP gRPC collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Prometheus metrics HTTP exposition port
PROMETHEUS_METRICS_PORT=9090
