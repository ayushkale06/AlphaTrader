{
  "$defs": {
    "CandleInterval": {
      "description": "Supported OHLCV bar aggregation intervals.",
      "enum": [
        "1m",
        "5m",
        "15m",
        "1h",
        "1d"
      ],
      "title": "CandleInterval",
      "type": "string"
    },
    "DataProvenance": {
      "additionalProperties": false,
      "description": "Explicit vendor lineage, feed regime, and dissemination delay metadata (ADR-005).",
      "properties": {
        "delay_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Delay in seconds (0 for real-time/sim, None if delayed but unknown).",
          "title": "Delay Seconds"
        },
        "feed_mode": {
          "$ref": "#/$defs/FeedMode",
          "description": "Origin regime: SIMULATED (walk), REPLAY (history), or LIVE (market feed)."
        },
        "ingested_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "UTC timestamp when the quote was received at the ingestion boundary.",
          "title": "Ingested At"
        },
        "is_delayed": {
          "default": false,
          "description": "True if the market quote is subject to an exchange dissemination delay.",
          "title": "Is Delayed",
          "type": "boolean"
        },
        "provider": {
          "description": "Vendor/source name (e.g. 'simulated_feed', 'replay_feed', 'yahoo_finance').",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "feed_mode"
      ],
      "title": "DataProvenance",
      "type": "object"
    },
    "FeedMode": {
      "description": "Canonical market data feed modes across configuration and payload contracts.",
      "enum": [
        "SIMULATED",
        "REPLAY",
        "LIVE"
      ],
      "title": "FeedMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Normalized OHLCV candlestick bar for an NSE NIFTY 50 symbol.",
  "properties": {
    "close": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "description": "Strictly positive price in INR (Decimal).",
      "gt": "0",
      "title": "Close"
    },
    "close_time": {
      "format": "date-time",
      "title": "Close Time",
      "type": "string"
    },
    "high": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "description": "Strictly positive price in INR (Decimal).",
      "gt": "0",
      "title": "High"
    },
    "interval": {
      "$ref": "#/$defs/CandleInterval"
    },
    "low": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "description": "Strictly positive price in INR (Decimal).",
      "gt": "0",
      "title": "Low"
    },
    "open": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "description": "Strictly positive price in INR (Decimal).",
      "gt": "0",
      "title": "Open"
    },
    "open_time": {
      "format": "date-time",
      "title": "Open Time",
      "type": "string"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/DataProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Data provenance and delay metadata. Required for schema >= 1.1.0."
    },
    "symbol": {
      "description": "Canonical NSE ticker symbol (e.g. 'RELIANCE.NS' or 'RELIANCE').",
      "title": "Symbol",
      "type": "string"
    },
    "trade_count": {
      "default": 0,
      "minimum": 0,
      "title": "Trade Count",
      "type": "integer"
    },
    "volume": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "description": "Non-negative quantity or volume (Decimal).",
      "ge": "0",
      "title": "Volume"
    },
    "vwap": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Strictly positive price in INR (Decimal).",
          "gt": "0"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vwap"
    }
  },
  "required": [
    "symbol",
    "interval",
    "open_time",
    "close_time",
    "open",
    "high",
    "low",
    "close",
    "volume"
  ],
  "title": "Candle",
  "type": "object"
}
