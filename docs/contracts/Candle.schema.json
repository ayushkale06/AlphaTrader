{
  "$defs": {
    "CandleInterval": {
      "description": "Supported OHLCV bar aggregation intervals.",
      "enum": [
        "1m",
        "5m",
        "15m",
        "1h",
        "1d"
      ],
      "title": "CandleInterval",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Normalized OHLCV candlestick bar for an NSE NIFTY 50 symbol.",
  "properties": {
    "close": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "description": "Strictly positive price in INR (Decimal).",
      "gt": "0",
      "title": "Close"
    },
    "close_time": {
      "format": "date-time",
      "title": "Close Time",
      "type": "string"
    },
    "high": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "description": "Strictly positive price in INR (Decimal).",
      "gt": "0",
      "title": "High"
    },
    "interval": {
      "$ref": "#/$defs/CandleInterval"
    },
    "low": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "description": "Strictly positive price in INR (Decimal).",
      "gt": "0",
      "title": "Low"
    },
    "open": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "description": "Strictly positive price in INR (Decimal).",
      "gt": "0",
      "title": "Open"
    },
    "open_time": {
      "format": "date-time",
      "title": "Open Time",
      "type": "string"
    },
    "symbol": {
      "description": "Canonical NSE ticker symbol (e.g. 'RELIANCE.NS' or 'RELIANCE').",
      "title": "Symbol",
      "type": "string"
    },
    "trade_count": {
      "default": 0,
      "minimum": 0,
      "title": "Trade Count",
      "type": "integer"
    },
    "volume": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "description": "Non-negative quantity or volume (Decimal).",
      "ge": "0",
      "title": "Volume"
    },
    "vwap": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Strictly positive price in INR (Decimal).",
          "gt": "0"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vwap"
    }
  },
  "required": [
    "symbol",
    "interval",
    "open_time",
    "close_time",
    "open",
    "high",
    "low",
    "close",
    "volume"
  ],
  "title": "Candle",
  "type": "object"
}
