{
  "$defs": {
    "ComponentSource": {
      "description": "Canonical identifiers for every AlphaTrader producer and consumer component.",
      "enum": [
        "mcp.market_data_streamer",
        "mcp.technical_analyst",
        "mcp.quant_strategy_engine",
        "mcp.risk_guardrail",
        "mcp.paper_execution_broker",
        "mcp.portfolio_ledger",
        "agent.analyst",
        "agent.quant",
        "agent.risk",
        "agent.execution",
        "orchestrator.langgraph",
        "system.core"
      ],
      "title": "ComponentSource",
      "type": "string"
    },
    "DataProvenance": {
      "additionalProperties": false,
      "description": "Explicit vendor lineage, feed regime, and dissemination delay metadata (ADR-005).",
      "properties": {
        "delay_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Delay in seconds (0 for real-time/sim, None if delayed but unknown).",
          "title": "Delay Seconds"
        },
        "feed_mode": {
          "$ref": "#/$defs/FeedMode",
          "description": "Origin regime: SIMULATED (walk), REPLAY (history), or LIVE (market feed)."
        },
        "ingested_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "UTC timestamp when the quote was received at the ingestion boundary.",
          "title": "Ingested At"
        },
        "is_delayed": {
          "default": false,
          "description": "True if the market quote is subject to an exchange dissemination delay.",
          "title": "Is Delayed",
          "type": "boolean"
        },
        "provider": {
          "description": "Vendor/source name (e.g. 'simulated_feed', 'replay_feed', 'yahoo_finance').",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "feed_mode"
      ],
      "title": "DataProvenance",
      "type": "object"
    },
    "FeedMode": {
      "description": "Canonical market data feed modes across configuration and payload contracts.",
      "enum": [
        "SIMULATED",
        "REPLAY",
        "LIVE"
      ],
      "title": "FeedMode",
      "type": "string"
    },
    "Tick": {
      "additionalProperties": false,
      "description": "Normalized real-time or replayed NSE NIFTY 50 quote/trade tick.",
      "properties": {
        "ask_price": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "description": "Strictly positive price in INR (Decimal).",
              "gt": "0"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ask Price"
        },
        "bid_price": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "description": "Strictly positive price in INR (Decimal).",
              "gt": "0"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bid Price"
        },
        "last_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Strictly positive price in INR (Decimal).",
          "gt": "0",
          "title": "Last Price"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Data provenance and delay metadata. Required for schema >= 1.1.0."
        },
        "sequence_number": {
          "default": 1,
          "description": "Monotonically increasing feed sequence number.",
          "minimum": 1,
          "title": "Sequence Number",
          "type": "integer"
        },
        "symbol": {
          "description": "Canonical NSE ticker symbol (e.g. 'RELIANCE.NS' or 'RELIANCE').",
          "title": "Symbol",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "volume": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Non-negative quantity or volume (Decimal).",
          "ge": "0",
          "title": "Volume"
        }
      },
      "required": [
        "symbol",
        "timestamp",
        "last_price",
        "volume"
      ],
      "title": "Tick",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "UUID of the upstream event that directly caused this event.",
      "title": "Causation Id"
    },
    "correlation_id": {
      "description": "End-to-end trace correlation ID carried from the originating tick or trigger.",
      "minLength": 1,
      "pattern": "\\S",
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "description": "Globally unique UUIDv4 identifier for idempotency and deduplication.",
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/Tick",
      "description": "Strongly typed domain event payload."
    },
    "produced_at": {
      "description": "UTC timestamp when the event was emitted.",
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "schema_version": {
      "default": "1.3.0",
      "description": "Semantic version of the envelope/payload contract.",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ComponentSource",
      "description": "Canonical AlphaTrader component that produced this event."
    }
  },
  "required": [
    "correlation_id",
    "source",
    "payload"
  ],
  "title": "EventEnvelope[Tick]",
  "type": "object"
}
