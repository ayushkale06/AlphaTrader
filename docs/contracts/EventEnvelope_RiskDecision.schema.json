{
  "$defs": {
    "ComponentSource": {
      "description": "Canonical identifiers for every AlphaTrader producer and consumer component.",
      "enum": [
        "mcp.market_data_streamer",
        "mcp.technical_analyst",
        "mcp.quant_strategy_engine",
        "mcp.risk_guardrail",
        "mcp.paper_execution_broker",
        "mcp.portfolio_ledger",
        "agent.analyst",
        "agent.quant",
        "agent.risk",
        "agent.execution",
        "orchestrator.langgraph",
        "system.core"
      ],
      "title": "ComponentSource",
      "type": "string"
    },
    "RiskDecision": {
      "additionalProperties": false,
      "description": "Audit record emitted by MCP Server 4 (Deterministic Risk Guardrail) for an order proposal.",
      "properties": {
        "approval_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Signed deterministic risk token required by the Paper Execution Broker.",
          "title": "Approval Token"
        },
        "decision": {
          "$ref": "#/$defs/RiskVerdict"
        },
        "decision_id": {
          "format": "uuid",
          "title": "Decision Id",
          "type": "string"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "inputs_snapshot": {
          "$ref": "#/$defs/RiskInputSnapshot"
        },
        "message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "order_request_id": {
          "format": "uuid",
          "title": "Order Request Id",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/RiskReasonCode"
        },
        "rule_fired": {
          "description": "Identifier of the deterministic rule that determined the verdict.",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Rule Fired",
          "type": "string"
        }
      },
      "required": [
        "order_request_id",
        "evaluated_at",
        "decision",
        "rule_fired",
        "reason_code",
        "inputs_snapshot",
        "message"
      ],
      "title": "RiskDecision",
      "type": "object"
    },
    "RiskInputSnapshot": {
      "additionalProperties": false,
      "description": "Immutable snapshot of portfolio and order metrics at the instant of risk evaluation.",
      "properties": {
        "current_drawdown_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Non-negative monetary amount in INR (Decimal).",
          "ge": "0",
          "title": "Current Drawdown Pct"
        },
        "max_daily_drawdown_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Strictly positive price in INR (Decimal).",
          "gt": "0",
          "title": "Max Daily Drawdown Pct"
        },
        "max_open_positions": {
          "minimum": 1,
          "title": "Max Open Positions",
          "type": "integer"
        },
        "max_position_size_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Strictly positive price in INR (Decimal).",
          "gt": "0",
          "title": "Max Position Size Pct"
        },
        "open_positions_count": {
          "minimum": 0,
          "title": "Open Positions Count",
          "type": "integer"
        },
        "orders_last_minute": {
          "default": 0,
          "minimum": 0,
          "title": "Orders Last Minute",
          "type": "integer"
        },
        "portfolio_equity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Strictly positive price in INR (Decimal).",
          "gt": "0",
          "title": "Portfolio Equity"
        },
        "post_trade_position_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Non-negative monetary amount in INR (Decimal).",
          "ge": "0",
          "title": "Post Trade Position Pct"
        },
        "proposed_notional": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Non-negative monetary amount in INR (Decimal).",
          "ge": "0",
          "title": "Proposed Notional"
        },
        "symbol": {
          "description": "Canonical NSE ticker symbol (e.g. 'RELIANCE.NS' or 'RELIANCE').",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "proposed_notional",
        "portfolio_equity",
        "current_drawdown_pct",
        "max_daily_drawdown_pct",
        "post_trade_position_pct",
        "max_position_size_pct",
        "open_positions_count",
        "max_open_positions"
      ],
      "title": "RiskInputSnapshot",
      "type": "object"
    },
    "RiskReasonCode": {
      "description": "Canonical machine-readable reason codes for risk guardrail evaluations.",
      "enum": [
        "WITHIN_LIMITS",
        "MAX_DAILY_DRAWDOWN_BREACH",
        "MAX_POSITION_SIZE_BREACH",
        "MAX_OPEN_POSITIONS_BREACH",
        "ORDER_RATE_LIMIT_EXCEEDED",
        "MARKET_CLOSED",
        "FLOOR_ALREADY_HALTED",
        "MISSING_STOP_LOSS",
        "MANUAL_KILL_SWITCH"
      ],
      "title": "RiskReasonCode",
      "type": "string"
    },
    "RiskVerdict": {
      "description": "Deterministic action taken by the non-LLM Risk Guardrail MCP server.",
      "enum": [
        "APPROVE",
        "REJECT",
        "HALT"
      ],
      "title": "RiskVerdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "UUID of the upstream event that directly caused this event.",
      "title": "Causation Id"
    },
    "correlation_id": {
      "description": "End-to-end trace correlation ID carried from the originating tick or trigger.",
      "minLength": 1,
      "pattern": "\\S",
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "description": "Globally unique UUIDv4 identifier for idempotency and deduplication.",
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/RiskDecision",
      "description": "Strongly typed domain event payload."
    },
    "produced_at": {
      "description": "UTC timestamp when the event was emitted.",
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "description": "Semantic version of the envelope/payload contract.",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ComponentSource",
      "description": "Canonical AlphaTrader component that produced this event."
    }
  },
  "required": [
    "correlation_id",
    "source",
    "payload"
  ],
  "title": "EventEnvelope[RiskDecision]",
  "type": "object"
}
