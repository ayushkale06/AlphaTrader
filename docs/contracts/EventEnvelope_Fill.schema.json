{
  "$defs": {
    "ComponentSource": {
      "description": "Canonical identifiers for every AlphaTrader producer and consumer component.",
      "enum": [
        "mcp.market_data_streamer",
        "mcp.technical_analyst",
        "mcp.quant_strategy_engine",
        "mcp.risk_guardrail",
        "mcp.paper_execution_broker",
        "mcp.portfolio_ledger",
        "agent.analyst",
        "agent.quant",
        "agent.risk",
        "agent.execution",
        "orchestrator.langgraph",
        "system.core"
      ],
      "title": "ComponentSource",
      "type": "string"
    },
    "Fill": {
      "additionalProperties": false,
      "description": "Simulated paper trade execution fill including Indian statutory transaction taxes.",
      "properties": {
        "exchange_fees": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "description": "Non-negative monetary amount in INR (Decimal).",
          "ge": "0",
          "title": "Exchange Fees"
        },
        "fill_id": {
          "format": "uuid",
          "title": "Fill Id",
          "type": "string"
        },
        "fill_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Strictly positive price in INR (Decimal).",
          "gt": "0",
          "title": "Fill Price"
        },
        "fill_quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Strictly positive order/fill quantity (Decimal).",
          "gt": "0",
          "title": "Fill Quantity"
        },
        "filled_at": {
          "format": "date-time",
          "title": "Filled At",
          "type": "string"
        },
        "gst_tax": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "description": "Non-negative monetary amount in INR (Decimal).",
          "ge": "0",
          "title": "Gst Tax"
        },
        "order_id": {
          "format": "uuid",
          "title": "Order Id",
          "type": "string"
        },
        "order_request_id": {
          "format": "uuid",
          "title": "Order Request Id",
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "slippage_bps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "description": "Non-negative monetary amount in INR (Decimal).",
          "ge": "0",
          "title": "Slippage Bps"
        },
        "stamp_duty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "description": "Non-negative monetary amount in INR (Decimal).",
          "ge": "0",
          "title": "Stamp Duty"
        },
        "stt_tax": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "description": "Non-negative monetary amount in INR (Decimal).",
          "ge": "0",
          "title": "Stt Tax"
        },
        "symbol": {
          "description": "Canonical NSE ticker symbol (e.g. 'RELIANCE.NS' or 'RELIANCE').",
          "title": "Symbol",
          "type": "string"
        },
        "total_fees": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "description": "Non-negative monetary amount in INR (Decimal).",
          "ge": "0",
          "title": "Total Fees"
        },
        "trading_mode": {
          "const": "PAPER",
          "default": "PAPER",
          "title": "Trading Mode",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "order_request_id",
        "symbol",
        "side",
        "fill_price",
        "fill_quantity",
        "filled_at"
      ],
      "title": "Fill",
      "type": "object"
    },
    "Side": {
      "description": "Order execution side.",
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "Side",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "UUID of the upstream event that directly caused this event.",
      "title": "Causation Id"
    },
    "correlation_id": {
      "description": "End-to-end trace correlation ID carried from the originating tick or trigger.",
      "minLength": 1,
      "pattern": "\\S",
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "description": "Globally unique UUIDv4 identifier for idempotency and deduplication.",
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/Fill",
      "description": "Strongly typed domain event payload."
    },
    "produced_at": {
      "description": "UTC timestamp when the event was emitted.",
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "description": "Semantic version of the envelope/payload contract.",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ComponentSource",
      "description": "Canonical AlphaTrader component that produced this event."
    }
  },
  "required": [
    "correlation_id",
    "source",
    "payload"
  ],
  "title": "EventEnvelope[Fill]",
  "type": "object"
}
