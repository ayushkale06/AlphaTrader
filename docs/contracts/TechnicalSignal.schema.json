{
  "$defs": {
    "CandleInterval": {
      "description": "Supported OHLCV bar aggregation intervals.",
      "enum": [
        "1m",
        "5m",
        "15m",
        "1h",
        "1d"
      ],
      "title": "CandleInterval",
      "type": "string"
    },
    "Direction": {
      "description": "Directional bias of a technical or quantitative trading signal.",
      "enum": [
        "LONG",
        "SHORT",
        "FLAT"
      ],
      "title": "Direction",
      "type": "string"
    },
    "MarketRegime": {
      "description": "Classified market volatility and trend regime for an NSE instrument.",
      "enum": [
        "TRENDING_UP",
        "TRENDING_DOWN",
        "MEAN_REVERTING",
        "HIGH_VOL_CHOP"
      ],
      "title": "MarketRegime",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Output of MCP Server 2 (Technical Analyst) and the Analyst Agent.",
  "properties": {
    "confidence": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "description": "Deterministic signal confidence score bounded in [0, 1].",
      "ge": "0",
      "le": "1",
      "title": "Confidence"
    },
    "direction": {
      "$ref": "#/$defs/Direction"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "indicators": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          }
        ]
      },
      "description": "Named indicator values (e.g. ema_9, ema_21, rsi_14, atr_14, vwap).",
      "title": "Indicators",
      "type": "object"
    },
    "interval": {
      "$ref": "#/$defs/CandleInterval",
      "default": "5m"
    },
    "regime": {
      "$ref": "#/$defs/MarketRegime",
      "default": "TRENDING_UP"
    },
    "signal_id": {
      "format": "uuid",
      "title": "Signal Id",
      "type": "string"
    },
    "symbol": {
      "description": "Canonical NSE ticker symbol (e.g. 'RELIANCE.NS' or 'RELIANCE').",
      "title": "Symbol",
      "type": "string"
    }
  },
  "required": [
    "symbol",
    "evaluated_at",
    "direction",
    "confidence",
    "indicators"
  ],
  "title": "TechnicalSignal",
  "type": "object"
}
